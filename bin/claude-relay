#!/usr/bin/env python3
"""claude-relay CLI shim for the clone-and-symlink dev flow.

The real CLI lives in `relay/cli.py` (also the pyproject console entry point). This script only
exists so a checkout can be run in place — it resolves its own real location (following the
symlink `install.sh` creates in ~/.local/bin) and puts the repo root on `sys.path` so
`import relay` works without a `pip install`. A pipx/uv install imports `relay.cli:main`
directly and never uses this file.
"""

from __future__ import annotations

import os
import sys

_SCRIPT_PATH = os.path.realpath(__file__)
_REPO_ROOT = os.path.dirname(os.path.dirname(_SCRIPT_PATH))
if _REPO_ROOT not in sys.path:
    sys.path.insert(0, _REPO_ROOT)

from relay.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
